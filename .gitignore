# Allowlist: only the entries below are published. Every other skill in
# ~/.claude/skills (personal or third-party) stays local and untracked.
/*
!/.gitignore
!/LICENSE
!/README.md
!/.claude-plugin/
!/docs/
!/rules/
/rules/*
!/rules/typst.md
!/rules/matplotlib.md
!/create-document/
!/doc-review/
!/google-tasks/
!/image-search/
!/mindmap/
!/typst/
!/diagram/
!/wayback/
!/verify/
!/sec-edgar/

.DS_Store
node_modules/
__pycache__/
.pytest_cache/
.ruff_cache/
