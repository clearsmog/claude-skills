# Palette header prepended by scripts/render.sh for the light render. Source files reference
# these tokens as ${name} or through the classes below, never as raw hex.
vars: {
  ink: "#141413"
  soft: "#6F6D64"
  line: "#8A877C"
  fill: "#FAF9F5"
  group: "#F0EEE6"
  accent: "#D97757"
  accent-fill: "#F7E4DB"
  warn: "#C6402F"
  warn-fill: "#F8DDD8"
  good: "#5F7A44"
  good-fill: "#E5EBDC"
  d2-config: {
    theme-overrides: {
      N1: "#141413"; N2: "#6F6D64"; N3: "#8A877C"; N4: "#D9D5CA"; N5: "#E5E2D9"; N6: "#F0EEE6"; N7: "#FFFFFF"
      B1: "#3D3A33"; B2: "#6F6D64"; B3: "#D9D5CA"; B4: "#F0EEE6"; B5: "#F5F3EC"; B6: "#FAF9F5"
      AA2: "#D97757"; AA4: "#F0EEE6"; AA5: "#F5F3EC"; AB4: "#F0EEE6"; AB5: "#F5F3EC"
    }
  }
}
